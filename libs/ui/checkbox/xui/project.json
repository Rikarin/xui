{
  "name": "checkbox",
  "$schema": "../../../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "libs/ui/checkbox/xui/src",
  "prefix": "xui",
  "projectType": "library",
  "tags": ["ui"],
  "targets": {
    "build": {
      "executor": "@nx/angular:package",
      "outputs": ["{workspaceRoot}/dist/{projectRoot}"],
      "options": {
        "project": "libs/ui/checkbox/xui/ng-package.json"
      },
      "configurations": {
        "production": {
          "tsConfig": "libs/ui/checkbox/xui/tsconfig.lib.prod.json"
        },
        "development": {
          "tsConfig": "libs/ui/checkbox/xui/tsconfig.lib.json"
        }
      },
      "defaultConfiguration": "production"
    },
    "nx-release-publish": {
      "options": {
        "packageRoot": "dist/{projectRoot}"
      }
    },
    "test": {
      "executor": "@nx/jest:jest",
      "outputs": ["{workspaceRoot}/coverage/{projectRoot}"],
      "options": {
        "jestConfig": "libs/ui/checkbox/xui/jest.config.ts"
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint"
    }
  }
}
