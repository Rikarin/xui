{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    // The server is a published Node ESM package: `nodenext` is what makes the emitted `.js`
    // real ESM and keeps the explicit `.js` import specifiers the runtime needs.
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "target": "es2022",
    "lib": ["es2023"],
    "types": ["node"],
    "strict": true,
    "ignoreDeprecations": "6.0"
  },
  "files": [],
  "include": [],
  "references": [
    {
      "path": "./tsconfig.lib.json"
    },
    {
      "path": "./tsconfig.spec.json"
    }
  ]
}
