import { createXConfigToken } from '@xui/core';
import type { <%= variantsName %> } from './<%= fileName %>';

/**
 * Application-wide defaults for <%= directiveName %>.
 *
 * Provide it once at the app root to re-skin every instance without touching
 * call sites; individual inputs still override the configured value.
 */
export interface Xui<%= className %>Config {
  color: <%= variantsName %>['color'];
  variant: <%= variantsName %>['variant'];
  size: <%= variantsName %>['size'];
}

export const [injectXui<%= className %>Config, provideXui<%= className %>Config] = createXConfigToken<Xui<%= className %>Config>('Xui<%= className %>Config', {
  color: 'primary',
  variant: 'default',
  size: 'md'
});
