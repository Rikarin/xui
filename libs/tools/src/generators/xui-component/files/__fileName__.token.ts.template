import { InjectionToken, ValueProvider, inject } from '@angular/core';
import type { <%= variantsName %> } from './<%= fileName %>';

/**
 * Application-wide defaults for <%= componentName %>.
 *
 * Provide it once at the app root to re-skin every instance without touching
 * call sites; individual inputs still override the configured value.
 */
export interface Xui<%= className %>Config {
  color: <%= variantsName %>['color'];
  variant: <%= variantsName %>['variant'];
  size: <%= variantsName %>['size'];
}

const defaultConfig: Xui<%= className %>Config = {
  color: 'primary',
  variant: 'default',
  size: 'md'
};

const Xui<%= className %>ConfigToken = new InjectionToken<Xui<%= className %>Config>('Xui<%= className %>Config');

export function provideXui<%= className %>Config(config: Partial<Xui<%= className %>Config>): ValueProvider {
  return { provide: Xui<%= className %>ConfigToken, useValue: { ...defaultConfig, ...config } };
}

export function injectXui<%= className %>Config(): Xui<%= className %>Config {
  return inject(Xui<%= className %>ConfigToken, { optional: true }) ?? defaultConfig;
}
