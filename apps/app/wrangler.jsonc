{
  "name": "xui-docs",
  "compatibility_date": "2025-11-01",
  // No `main`, and so no Worker: every route the app has is prerendered, and the deployment is the
  // assets alone. That also takes the site out from under the Worker size limit, which
  // `@angular/ssr` was filling with a second copy of all 111 prerendered pages — inlined into the
  // bundle for routes this binding serves first.
  "assets": {
    "directory": "../../dist/apps/app/browser",
    // `404.html` is the prerendered not-found page, copied into place by `nx bundle app`. Served
    // with a real 404, it reads without JavaScript, and the router renders the same component over
    // it on boot — so hydration finds the markup it would have built.
    "not_found_handling": "404-page"
  },
  "observability": {
    "enabled": true
  }
}
