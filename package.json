{
  "name": "xui",
  "version": "0.0.0",
  "private": true,
  "description": "Modern Angular 22 UI Library based on TailwindCSS",
  "keywords": [
    "angular",
    "ui",
    "components",
    "tailwindcss"
  ],
  "homepage": "https://xuijs.org",
  "bugs": {
    "url": "https://github.com/rikarin/xui/issues"
  },
  "repository": "https://github.com/Rikarin/xui",
  "license": "Apache-2.0",
  "author": "Jiu",
  "maintainers": [
    "Jiu",
    "Rikarin"
  ],
  "type": "module",
  "scripts": {
    "build": "nx run-many --target build --all --parallel",
    "build-storybook": "nx build-storybook ui-storybook",
    "chromatic": "chromatic",
    "dev": "nx serve app",
    "format": "nx format --write",
    "lint": "nx run-many --target=lint --parallel",
    "local-registry": "nx local-registry",
    "prepare": "test -n \"$CI\" || git config core.hooksPath .githooks",
    "release": "nx release --skip-publish",
    "release:dry-run": "nx release --skip-publish --dry-run",
    "release:publish": "nx release publish",
    "start": "nx serve app",
    "storybook": "nx storybook ui-storybook",
    "test": "nx run-many --target test --all",
    "test-storybook": "nx test-storybook ui-storybook",
    "update-projects": "nx g @xui/tools:update-projects"
  },
  "dependencies": {
    "@angular/animations": "22.2.4",
    "@angular/cdk": "22.2.5",
    "@angular/common": "22.2.4",
    "@angular/compiler": "22.2.4",
