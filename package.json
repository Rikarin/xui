    "@ng-icons/material-icons": "^36.1.0",
    "@tailwindcss/postcss": "^4.3.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "echarts": "^6.1.0",
    "express": "^5.3.0",
    "konva": "^10.9.0",
    "luxon": "^3.7.2",
